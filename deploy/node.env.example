# DeeChat relay node — environment file.
#
# Copy to /etc/deechat/node.env (mode 0640, owned root:deechat) and edit.
# Then derive the memory ceiling for THIS file and put it in the unit:
#
#   deploy/memory-ceiling.sh /etc/deechat/node.env
#
# Every value here is read once at boot. Changing any of them is a restart, and
# a restart discards this relay's queues, which costs a sender still online
# latency rather than messages, because the client resends what was not acked.

# --- Identity ---------------------------------------------------------------
DEE_NODE_ID=relay-1
# Loopback only. The reverse proxy terminates TLS and forwards here; the node
# never faces the internet directly and never needs a privileged port.
#
# For the CONTAINER unit this must be :8080 instead — the process binds inside
# a network namespace where 127.0.0.1 is not reachable from the host, and
# --publish 127.0.0.1:8080:8080 does the loopback binding on the outside.
DEE_NODE_ADDR=127.0.0.1:8080
DEE_NODE_PUBLIC_URL=https://relay-1.example.org

# --- Queue-read authorization ------------------------------------------------
# false while clients roll out. Flipping it is a coordinated step, not a switch:
# every client fetching from this relay has to present a queue-read capability
# first, or its mail stops arriving — see the main README, § "Queue-read
# authorization". Whatever you set, the monitoring must ASSERT the value back
# from GET /health: an unparseable value
# (DEE_NODE_REQUIRE_FETCH_AUTH=ture) boots cleanly and enforces nothing.
DEE_NODE_REQUIRE_FETCH_AUTH=false

# --- Relay admission ------------------------------------------------------------
# Which circles this relay carries mail for. UNSET MEANS OPEN, not closed: a
# relay with no credential file applies the caps in this file to everyone, which
# is the free self-hosted path and is meant to stay exactly that generous.
#
# That is also why enforcement is a separate switch. Set the file, watch, then
# flip DEE_NODE_REQUIRE_ADMISSION — and ASSERT the value back from GET /health,
# because DEE_NODE_REQUIRE_ADMISSION=ture boots cleanly and gates nothing. With
# the switch on and no credentials loaded the node refuses to boot.
#
# The file holds PUBLIC KEYS, never codes: a copy of it admits nobody. It is read
# and never written, so it belongs to whatever issues codes, not to the node.
# `kill -HUP` re-reads it — revoking one circle by restarting would drop every
# other circle's undelivered mail, because the queues are RAM-only.
#
#   {"credentials":[
#     {"credential":"<base64url ed25519 public key>",
#      "terms":{"tier":"crew","notAfter":"2026-09-01T00:00:00Z",
#               "queueSlots":1320,"retentionWindow":"48h",
#               "attachmentBytes":104857600,"concurrentTransfers":4,
#               "transitBytesPerDay":53687091200}}]}
#
# Every capacity field is optional and ZERO MEANS "use the cap in this file".
# A credential may only ever LOWER one, never raise it — so the numbers below are
# the ceiling for every circle on this box, whatever their terms say. Nothing may
# be added to the file beyond these fields: it does not load if it carries a
# customer name or an email, deliberately — billing identity and relay slot must
# not be joinable in one place.
#
# The shared-pool box must run DEE_NODE_MAX_ATTACHMENT_BYTES at 100 MB or every
# hosted tier is silently capped at the 50 MB below.
#DEE_NODE_ADMISSION_FILE=/etc/deechat/credentials.json
DEE_NODE_REQUIRE_ADMISSION=false

# --- Mesh replication ---------------------------------------------------------
# Unset means mesh is OFF and there is no mesh listener — not that it is open.
# Leave all of it unset until there is a second relay to replicate with.
#
# REMOVED: DEE_NODE_TRUSTED_NODES. It named public relay urls and doubled as a
# gossip seed; both meanings are gone and the node now REFUSES TO BOOT if it is
# set, because a peer list that is silently ignored is a pool that believes it
# replicates and does not. Use DEE_NODE_MESH_PEERS with peering urls.
#
# The secret: one value shared by every pool member,
#   openssl rand -base64 32
# It proves pool membership, not peer identity — any member can impersonate any
# other.
#DEE_NODE_MESH_SECRET=
#
# The mesh listener. /mesh/* is NOT served on DEE_NODE_ADDR in any
# configuration, so replication needs its own address, and that address must be
# on a private interface the other relays can reach: WireGuard, Tailscale, or a
# provider private network. The node refuses to boot on a wildcard bind (":8081")
# or a public address — the mesh endpoint serves every identity's queued records
# to anyone holding the pool secret.
#
# For the CONTAINER unit, bind the container side (0.0.0.0 inside its own
# namespace is not reachable from outside it) and let --publish do the private
# binding: --publish 10.0.0.1:8081:8081, with DEE_NODE_MESH_ADDR=127.0.0.1:8081
# refused — use the container's own address. See the unit file.
#DEE_NODE_MESH_ADDR=10.0.0.1:8081
#
# The peers: the peering urls of the OTHER members, comma-separated. This is the
# complete list of hosts this node will send the pool secret to, and it comes
# from here and nowhere else — a peer cannot introduce another peer.
#
# Every member must list every other member: replication is pull-only, so a
# record crosses when the RECEIVING relay pulls it. A one-way list replicates one
# way.
#DEE_NODE_MESH_PEERS=http://10.0.0.2:8081,http://10.0.0.3:8081
#DEE_NODE_MESH_SYNC_INTERVAL=30s
#DEE_NODE_MESH_REQUEST_TIMEOUT=5s

# --- Queue caps ---------------------------------------------------------------
# Sized per the tiers in README.md ("Capacity sizing"). These are the 1k-user
# figures. DEE_NODE_MAX_ACKS defaults to 2x messages if unset, and must stay
# above DEE_NODE_MAX_MESSAGES: the difference is the budget client-posted acks
# may occupy, and the reserve below it is what keeps POST /messages working when
# that budget is full. The node refuses to boot if there is no budget left.
DEE_NODE_MAX_MESSAGES=10000
DEE_NODE_MAX_ACKS=20000
DEE_NODE_MAX_PURGES=1000
DEE_NODE_MAX_PER_PAIR=10
DEE_NODE_MAX_PAYLOAD_BYTES=8192
DEE_NODE_MAX_TTL=72h
DEE_NODE_DEFAULT_TTL=24h
DEE_NODE_CLEANUP_INTERVAL=30s

# --- Attachment relay ---------------------------------------------------------
# The dominant memory term, and the one the defaults get wrong for a VPS:
# 256 sessions x 8 chunks x 1 MiB is a 2 GiB ceiling.
#
# The lever is sessions and window, NOT chunk size: the client sends 512 KiB
# plaintext chunks, which encrypt and base64 to roughly 700 KiB, so a chunk cap
# below 1 MiB rejects every chunk with invalid_attachment_chunk.
#
# 16 x 4 x 1 MiB = 64 MiB, i.e. 16 concurrent transfers relay-wide. A 17th gets
# 429 relay_busy and the sender retries — back-pressure, not loss.
DEE_NODE_RELAY_MAX_SESSIONS=16
DEE_NODE_RELAY_MAX_WINDOW=4
DEE_NODE_MAX_CHUNK_BYTES=1048576

# The largest whole attachment this relay carries, published on /health so the
# app can size its send guard to this host rather than to a constant compiled
# into the build. Independent of the footprint above — the relay still holds only
# one window per transfer, however large the file is.
DEE_NODE_MAX_ATTACHMENT_BYTES=52428800
DEE_NODE_RELAY_IDLE_TIMEOUT=30s
DEE_NODE_RELAY_POLL_TIMEOUT=25s

# Transport deadlines. The first bounds how long a request *body* may take to
# arrive after its headers — bodies only, so the long poll above still parks for
# its full budget. The second closes a kept-alive connection that is idle between
# requests. Both exist because a client that abandons a request without closing
# the socket otherwise leaves a goroutine and a connection parked on this relay
# until it restarts.
DEE_NODE_BODY_READ_TIMEOUT=20s
DEE_NODE_IDLE_TIMEOUT=120s

# --- Prekeys -------------------------------------------------------------------
DEE_NODE_PREKEY_CLAIM_BURST=32
DEE_NODE_PREKEY_CLAIM_REFILL=1s
# How many one-time-prekey pools this box holds at once, one per publishing
# device. Sized like the presence store: "how many identities does this box
# serve", not how much mail they send. At the ceiling a publish from a device
# the box is not already carrying is refused (429) instead of evicting a pool
# somebody is relying on, and the sender falls back to a v2 envelope. Raising it
# raises the derived MemoryMax — deploy/memory-ceiling.sh counts this term.
DEE_NODE_MAX_PREKEY_BUCKETS=5000

# --- Go runtime -----------------------------------------------------------------
# From deploy/memory-ceiling.sh, alongside the unit's MemoryMax. A soft limit:
# the collector works harder near it instead of the kernel killing the process
# and taking every queued message with it.
GOMEMLIMIT=REPLACE_ME
